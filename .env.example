# ==============================================================================
# AI-Based National Cleanliness Monitoring System - Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN REAL CREDENTIALS FOR YOUR DEPLOYMENT.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & APPLICATION SETTINGS
# ------------------------------------------------------------------------------
PROJECT_NAME="AI-Based National Cleanliness Monitoring System"
ENVIRONMENT="development"                      # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_RELOAD=true
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate a secure key in production with: openssl rand -hex 32
JWT_SECRET_KEY="change_this_to_a_secure_random_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480                 # 8 hours

# Default initial administrator (bootstrapped on first run if no user exists)
INITIAL_ADMIN_EMAIL="admin@cleanliness.gov.in"
INITIAL_ADMIN_PASSWORD="ChangeMe@Admin2026"
INITIAL_ADMIN_FULL_NAME="National System Administrator"

# ------------------------------------------------------------------------------
# MONGODB DATABASE
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="cleanliness_monitoring_db"
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_POOL_SIZE=50

# ------------------------------------------------------------------------------
# STORAGE & FILE PATHS
# ------------------------------------------------------------------------------
STORAGE_BASE_DIR="./storage"
SNAPSHOT_STORAGE_DIR="./storage/snapshots"
LOG_STORAGE_DIR="./storage/logs"
TEST_VIDEO_DIR="./storage/test_videos"

# ------------------------------------------------------------------------------
# VIDEO INGESTION & RTSP SETTINGS
# ------------------------------------------------------------------------------
DEFAULT_FRAME_WIDTH=1280
DEFAULT_FRAME_HEIGHT=720
TARGET_STREAM_FPS=15
PROCESS_EVERY_N_FRAMES=3                       # Process 1 out of every 3 frames to optimize compute
FRAME_BUFFER_MAXSIZE=30                        # Ring buffer capacity per camera
RTSP_RECONNECT_INTERVAL_SECONDS=5
RTSP_CONNECTION_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# AI DETECTION & VALIDATION THRESHOLDS
# ------------------------------------------------------------------------------
SOLID_MODEL_PATH="./ai/models/weights/solid_waste_yolo.pt"
LIQUID_MODEL_PATH="./ai/models/weights/liquid_waste_yolo_seg.pt"

# Confidence thresholds
SOLID_CONFIDENCE_THRESHOLD=0.45
LIQUID_CONFIDENCE_THRESHOLD=0.40

# Temporal persistence & Incident generation rules
# Object must be tracked / confirmed across N consecutive processed frames before incident creation
SOLID_TEMPORAL_CONFIRMATION_FRAMES=5
LIQUID_TEMPORAL_CONFIRMATION_FRAMES=4

# Minimum pixel count or area ratio for liquid spills to eliminate small sensor artifacts
LIQUID_MIN_AFFECTED_AREA_PIXELS=1200

# Cooldown window (in seconds) to avoid duplicate incident creation for the same persistent event
INCIDENT_DEDUPLICATION_COOLDOWN_SECONDS=180

# ------------------------------------------------------------------------------
# WEBSOCKET & NOTIFICATION SETTINGS
# ------------------------------------------------------------------------------
WS_PING_INTERVAL_SECONDS=20
WS_PING_TIMEOUT_SECONDS=10
